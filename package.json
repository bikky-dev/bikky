{
  "name": "bikky",
  "version": "0.3.0",
  "description": "Shared memory for AI coding sessions — MCP server + background daemon",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/bikky-dev/bikky.git"
  },
  "bin": {
    "bikky": "./bin/bikky.js"
  },
  "exports": {
    ".": "./dist/mcp/index.js"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "scripts": {
    "build": "tsc",
    "postinstall": "node dist/postinstall.js || true",
    "start": "node dist/mcp/index.js",
    "daemon": "node dist/daemon/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "check": "tsc --noEmit && eslint src/",
    "test": "node --test dist/*.test.js dist/**/*.test.js",
    "test:integration": "tsc && BIKKY_INTEGRATION=${BIKKY_INTEGRATION:-1} node --test dist/**/*.itest.js",
    "build:diagrams": "node scripts/build-diagrams.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1006.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "copilot",
    "claude-code",
    "shared-memory",
    "vector-search",
    "qdrant"
  ]
}

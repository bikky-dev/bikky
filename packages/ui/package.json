{
  "name": "bikky-ui",
  "version": "0.1.11",
  "description": "Local web UI for browsing and managing bikky memory",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/bikky-dev/bikky.git",
    "directory": "packages/ui"
  },
  "bin": {
    "bikky-ui": "./bin/bikky-ui.js"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "scripts": {
    "build": "tsc && npm run build:ui",
    "build:server": "tsc",
    "build:ui": "vite build --config app/vite.config.ts",
    "dev": "vite --config app/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test --test-isolation=process --test-concurrency=1 \"dist/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.7.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "d3-force": "^3.0.0",
    "lucide-react": "^0.475.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
